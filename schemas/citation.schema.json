{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "source_record_id",
    "target_legislation_id",
    "raw_text",
    "extraction_method",
    "validation_status",
    "schema_version",
    "created_at",
    "source",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string" },
    "record_type": { "type": "string", "const": "citation" },
    "source_record_id": { "type": "string" },
    "target_legislation_id": { "type": "string" },
    "target_article_id": { "type": ["string", "null"] },
    "raw_text": { "type": "string" },
    "source_span": {
      "type": ["object", "null"],
      "properties": {
        "char_start": { "type": ["integer", "null"] },
        "char_end": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "extraction_method": { "type": "string" },
    "validation_status": { "type": "string" },
    "schema_version": { "type": "string" },
    "created_at": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["source_id", "source_url", "retrieved_at", "artifact_sha256"],
      "properties": {
        "source_id": { "type": "string" },
        "source_url": { "type": "string" },
        "retrieved_at": { "type": "string" },
        "artifact_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "artifact_path": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["parser_name", "parser_version", "pipeline_run_id"],
      "properties": {
        "parser_name": { "type": "string" },
        "parser_version": { "type": "string" },
        "pipeline_run_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
