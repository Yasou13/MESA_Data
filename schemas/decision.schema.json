{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "jurisdiction",
    "language",
    "court",
    "text",
    "schema_version",
    "created_at",
    "source",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string" },
    "record_type": { "type": "string", "const": "decision" },
    "jurisdiction": { "type": "string", "const": "TR" },
    "language": { "type": "string", "const": "tr" },
    "court": { "type": "string" },
    "chamber": { "type": ["string", "null"] },
    "esas_no": { "type": ["string", "null"] },
    "karar_no": { "type": ["string", "null"] },
    "decision_date": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "text": { "type": "string" },
    "verdict": { "type": ["string", "null"] },
    "schema_version": { "type": "string" },
    "created_at": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["source_id", "source_url", "retrieved_at", "artifact_sha256"],
      "properties": {
        "source_id": { "type": "string" },
        "source_url": { "type": "string" },
        "retrieved_at": { "type": "string" },
        "artifact_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "artifact_path": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["parser_name", "parser_version", "pipeline_run_id"],
      "properties": {
        "parser_name": { "type": "string" },
        "parser_version": { "type": "string" },
        "pipeline_run_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
