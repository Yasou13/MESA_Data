# ─── MESA Legal Data — Ortam Değişkenleri ───
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun:
#   cp .env.example .env

# Veri kök dizini (raw, canonical, releases, catalog.sqlite burada saklanır)
MESA_DATA_DATA_ROOT=/storage/mesa-legal-data/data

# MESA staging veritabanı yolu
MESA_DATA_MESA_STAGING_DB=/storage/mesa-legal-data/data/mesa_staging.sqlite

# Çalışma ortamı: development | production | testing
MESA_DATA_ENVIRONMENT=development

# Log seviyesi: DEBUG | INFO | WARNING | ERROR | CRITICAL
MESA_DATA_LOG_LEVEL=INFO

# Operatör iletişim bilgisi (Otomatik web aramalarında User-Agent başlığında kullanılır; placeholder kabul edilmez)
# MESA_DATA_OPERATOR_CONTACT=contact@yourdomain.org

# HTTP proxy (isteğe bağlı, gerekli değilse boş bırakın)
# MESA_DATA_HTTP_PROXY=http://proxy.example.com:8080

# ─── Güvenlik ───

# Web paneli admin token'ı
# Yalnız 127.0.0.1'de çalışırken zorunlu değildir.
# Dış ağa açarken (--host 0.0.0.0) MUTLAKA ayarlayın.
# Güçlü, rastgele bir değer kullanın (örn: openssl rand -hex 32)
# MESA_DATA_WEB_ADMIN_TOKEN=
